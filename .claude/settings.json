{
  "permissions": {
    "allow": [
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run view:*)",
      "Bash(yamllint .)",
      "Bash(ansible-lint)"
    ],
    "deny": [
      "Bash(git -C *)",
      "Bash(git stash:*)",
      "Bash(git checkout:*)",
      "Bash(git reset:*)",
      "Bash(git worktree:*)"
    ]
  }
}
